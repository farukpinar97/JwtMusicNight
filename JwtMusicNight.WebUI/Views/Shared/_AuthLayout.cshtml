<!DOCTYPE html>
<html lang="tr" dir="ltr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] | Music Night</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/assets/css/bootstrap.css" />
    <link rel="stylesheet" href="~/assets/css/theme.css" />
    <link rel="stylesheet" href="~/css/site-ui.css" asp-append-version="true" />
</head>
<body class="mn-body">
    <div class="mn-auth">
        <div class="mn-auth-visual">
            <div class="bg" style="background-image:url(/assets/img/auth-bg.jpg)"></div>
            <div class="d-flex align-items-center text-white font-weight-bold" style="gap:10px; font-size:19px">
                <span style="width:34px;height:34px;border-radius:10px;background:linear-gradient(135deg,#8b5cf6,#d946ef);display:inline-flex;align-items:center;justify-content:center">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="2.5"></circle></svg>
                </span>
                Music Night
            </div>
            <div>
                <h2>Müziğin ritmi,<br />paketinin gücü.</h2>
                <p>20 şarkı, 9 sanatçı, 7 tür. Paketine göre dinle, yükselt, yeni sesler keşfet.</p>
                <div class="mn-auth-pkgs">
                    <span class="mn-pill pkg-Basic">Basic</span>
                    <span class="mn-pill pkg-Gold">Gold</span>
                    <span class="mn-pill pkg-Premium">Premium</span>
                    <span class="mn-pill pkg-Elit">Elit</span>
                </div>
            </div>
        </div>
        <div class="mn-auth-form">
            <div class="mn-auth-box">
                @RenderBody()
            </div>
        </div>
    </div>
</body>
</html>
