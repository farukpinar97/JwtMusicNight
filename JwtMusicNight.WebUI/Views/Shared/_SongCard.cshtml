@model ResultSongDto
@{
    var canListen = PackageHelper.CanListen(User, Model.RequiredPackage);
}
@* data-id: oynatıcı bu öğeyi şarkı olarak tanır *@
<div class="mn-card" data-id="@Model.SongId" data-package="@Model.RequiredPackage" data-source="">
    <div class="cover">
        <a asp-controller="Music" asp-action="Detail" asp-route-id="@Model.SongId"
           class="ajax media-content" style="background-image:url(@Model.CoverImageUrl)" aria-label="@Model.SongName"></a>
        <div class="badges">
            <span class="mn-pill pkg-@Model.RequiredPackage">@Model.RequiredPackage</span>
            @if (!canListen)
            {
                <span class="mn-lock" title="Paketin bu şarkıyı desteklemiyor">🔒</span>
            }
        </div>
        <div class="play-wrap">
            <button class="btn btn-raised btn-icon btn-rounded bg--white btn-play" aria-label="@Model.SongName çal"></button>
        </div>
    </div>
    <div class="info">
        <a asp-controller="Music" asp-action="Detail" asp-route-id="@Model.SongId" class="title ajax">@Model.SongName</a>
        <a asp-controller="Artist" asp-action="Detail" asp-route-id="@Model.ArtistId" class="subtitle ajax">@Model.ArtistName</a>
        <div class="extra">@Model.GenreName · @Model.Duration.ToString(@"m\:ss")</div>
    </div>
</div>
