/symbol><symbol id="plyr-fast-forward" viewBox="0 0 18 18"><path d="M7.875 7.171L0 1v16l7.875-6.171V17L18 9 7.875 1z"/></symbol><symbol id="plyr-muted" viewBox="0 0 18 18"><path d="M5 7v4h3l4 4V3L8 7H5z"/></symbol><symbol id="plyr-pause" viewBox="0 0 18 18"><path d="M6 1H3c-.6 0-1 .4-1 1v14c0 .6.4 1 1 1h3c.6 0 1-.4 1-1V2c0-.6-.4-1-1-1zM12 1c-.6 0-1 .4-1 1v14c0 .6.4 1 1 1h3c.6 0 1-.4 1-1V2c0-.6-.4-1-1-1h-3z"/></symbol><symbol id="plyr-pip" viewBox="0 0 18 18"><path d="M13.293 3.293L7.022 9.564l1.414 1.414 6.271-6.271L17 7V1h-6z"/><path d="M13 15H3V5h5V3H2a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-6h-2v5z"/></symbol><symbol id="plyr-play" viewBox="0 0 18 18"><path d="M16.562 8.1l-11.692-7.875c-0.818-0.562-1.87 0-1.87 0.9v15.75c0 0.9 1.052 1.462 1.87 0.9l11.693-7.875c0.584-0.45 0.584-1.35 0-1.8z"/></symbol><symbol id="plyr-restart" viewBox="0 0 18 18"><path d="M9.7 1.2l.7 6.4 2.1-2.1c1.9 1.9 1.9 5.1 0 7-.9 1-2.2 1.5-3.5 1.5-1.3 0-2.6-.5-3.5-1.5-1.9-1.9-1.9-5.1 0-7 .6-.6 1.4-1.1 2.3-1.3l-.6-1.9C6 2.6 4.9 3.2 4 4.1 1.3 6.8 1.3 11.2 4 14c1.3 1.3 3.1 2 4.9 2 1.9 0 3.6-.7 4.9-2 2.7-2.7 2.7-7.1 0-9.9L16 1.9l-6.3-.7z"/></symbol><symbol id="plyr-rewind" viewBox="0 0 18 18"><path d="M10.125 1L0 9l10.125 8v-6.171L18 17V1l-7.875 6.171z"/></symbol><symbol id="plyr-settings" viewBox="0 0 18 18"><path d="M16.135 7.784a2 2 0 0 1-1.23-2.969c.322-.536.225-.998-.094-1.316l-.31-.31c-.318-.318-.78-.415-1.316-.094a2 2 0 0 1-2.969-1.23C10.065 1.258 9.669 1 9.219 1h-.438c-.45 0-.845.258-.997.865a2 2 0 0 1-2.969 1.23c-.536-.322-.999-.225-1.317.093l-.31.31c-.318.318-.415.781-.093 1.317a2 2 0 0 1-1.23 2.969C1.26 7.935 1 8.33 1 8.781v.438c0 .45.258.845.865.997a2 2 0 0 1 1.23 2.969c-.322.536-.225.998.094 1.316l.31.31c.319.319.782.415 1.316.094a2 2 0 0 1 2.969 1.23c.151.607.547.865.997.865h.438c.45 0 .845-.258.997-.865a2 2 0 0 1 2.969-1.23c.535.321.997.225 1.316-.094l.31-.31c.318-.318.415-.781.094-1.316a2 2 0 0 1 1.23-2.969c.607-.151.865-.547.865-.997v-.438c0-.451-.26-.846-.865-.997zM9 12a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/></symbol><symbol id="plyr-volume" viewBox="0 0 18 18"><path d="M12.79 9c0-1.3-.72-2.42-1.79-3v6c1.06-.58 1.79-1.7 1.79-3zM2 7v4h3l4 4V3L5 7H2zm9-5v1.5c2.32.74 4 2.93 4 5.5s-1.68 4.76-4 5.5V16c3.15-.78 5.5-3.6 5.5-7S14.15 2.78 11 2z"/></symbol><symbol id="plyr-prev" viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></symbol><symbol id="plyr-next" viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></symbol><symbol id="plyr-shuffle" viewBox="0 0 24 24"><path d="M10.59 9.17L5.41 4 4 5.41l5.17 5.17 1.42-1.41zM14.5 4l2.04 2.04L4 18.59 5.41 20 17.96 7.46 20 9.5V4h-5.5zm.33 9.41l-1.41 1.41 3.13 3.13L14.5 20H20v-5.5l-2.04 2.04-3.13-3.13z"/></symbol><symbol id="plyr-repeat" viewBox="0 0 24 24"><path d="M7 7h10v3l4-4-4-4v3H5v6h2V7zm10 10H7v-3l-4 4 4 4v-3h12v-6h-2v4z"/></symbol><symbol id="plyr-list" viewBox="0 0 24 24"><path d="M15 6H3v2h12V6zm0 4H3v2h12v-2zM3 16h8v-2H3v2zM17 6v8.18c-.31-.11-.65-.18-1-.18-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3V8h3V6h-5z"/></symbol><symbol id="plyr-like" viewBox="0 0 24 24"><path d="M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z"/></symbol><symbol id="plyr-liked" viewBox="0 0 24 24"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></symbol>
</svg>
    <header id="header" class="page-header mn-header">
        <div class="navbar navbar-expand-lg">
            <a asp-controller="Music" asp-action="Index" class="navbar-brand text-white">
                <span class="brand-logo">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2">
                        <circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="2.5"></circle>
                    </svg>
                </span>
                Music Night
            </a>

            <div class="collapse navbar-collapse order-4 order-lg-1 flex-grow-0" id="navbarCollapse">
                <ul class="navbar-nav ml-lg-3" data-nav>
                    <li class="nav-item @Active("Music")">
                        <a asp-controller="Music" asp-action="Index" class="nav-link"><i data-feather="compass"></i><span>Keşfet</span></a>
                    </li>
                    <li class="nav-item @Active("Chart")">
                        <a asp-controller="Chart" asp-action="Index" class="nav-link"><i data-feather="trending-up"></i><span>Listeler</span></a>
                    </li>
                    <li class="nav-item @Active("Genre")">
                        <a asp-controller="Genre" asp-action="Index" class="nav-link"><i data-feather="grid"></i><span>Türler</span></a>
                    </li>
                    <li class="nav-item @Active("Artist")">
                        <a asp-controller="Artist" asp-action="Index" class="nav-link"><i data-feather="mic"></i><span>Sanatçılar</span></a>
                    </li>
                </ul>
            </div>

            <form asp-controller="Music" asp-action="Search" method="get" class="mn-search js-search-form order-lg-2 ml-auto mr-3 d-none d-md-flex" role="search">
                <i data-feather="search"></i>
                <input name="q" placeholder="Şarkı, sanatçı, tür ara…" autocomplete="off" aria-label="Ara" />
            </form>
            @* Arama sonucu pjax ile açılır (site-ui.js) *@
            <a href="/Music/Search" class="d-none" id="mnSearchLink" aria-hidden="true" tabindex="-1"></a>

            <ul class="nav navbar-menu order-1 order-lg-3 align-items-center">
                <li class="nav-item dropdown">
                    <a href="#" data-toggle="dropdown" class="user-chip">
                        <span class="mn-pill pkg-@package">@package</span>
                        <span class="d-none d-md-inline font-weight-bold">@givenName</span>
                        <img src="@AvatarHelper.For(User)" alt="" />
                    </a>
                    <div class="dropdown-menu dropdown-menu-right mt-2">
                        <div class="dropdown-head">
                            <b>@fullName</b>
                            <span class="text-muted text-sm">@@@(User.Identity?.Name) · @package paket</span>
                        </div>
                        <a class="dropdown-item" asp-area="" asp-controller="Account" asp-action="Index">👤 Hesabım &amp; Paketim</a>
                        <a class="dropdown-item d-md-none" asp-area="" asp-controller="Music" asp-action="Search">🔍 Ara</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="dropdown-item no-ajax" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">⚙️ Admin Paneli</a>
                        }
                        <a class="dropdown-item no-ajax" asp-area="" asp-controller="Login" asp-action="Logout">↩ Çıkış Yap</a>
                    </div>
                </li>
                <li class="nav-item d-lg-none ml-2">
                    <a href="#" class="nav-link px-2 text-white" data-toggle="collapse" data-toggle-class data-target="#navbarCollapse">
                        <i data-feather="menu"></i>
                    </a>
                </li>
            </ul>
        </div>
    </header>

    <div id="main" class="layout-row flex">
        <div id="content" class="flex">
            @RenderBody()
        </div>
    </div>

    <!-- 403: paket uyarısı pop-up'ı -->
    <div class="modal fade" id="upgradeModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content text-center">
                <div class="modal-body p-5">
                    <div style="font-size:48px">🔒</div>
                    <h5 class="mt-3 mb-3 font-weight-bold">Paket Yetkisi Gerekli</h5>
                    <p class="js-message">Mevcut paketiniz bu şarkıyı desteklememektedir. Lütfen paketinizi yükseltin.</p>
                    <p class="text-muted text-sm mb-4">
                        Paketiniz: <b class="js-user-package"></b> &middot;
                        Gereken paket: <b class="js-required-package"></b>
                    </p>
                    <div class="d-flex justify-content-center flex-wrap" style="gap:10px">
                        <a href="/Account/Index" class="mn-btn mn-btn-light js-modal-link">Paketleri incele</a>
                        <button type="button" class="mn-btn mn-btn-ghost" data-dismiss="modal">Kapat</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- diğer hatalar (dosya yok vb.) -->
    <div class="modal fade" id="errorModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
            <div class="modal-content text-center">
                <div class="modal-body p-4">
                    <h6 class="mb-3 font-weight-bold">Şarkı çalınamadı</h6>
                    <p class="js-message text-muted"></p>
                    <button type="button" class="mn-btn mn-btn-ghost" data-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <footer id="footer" class="page-footer">
        <div class="mn-footer">
            <span>&copy; @DateTime.Now.Year Music Night · JWT tabanlı müzik platformu</span>
        </div>

        <!-- MP3 çalar -->
        <div data-plugin="plyr" class="plyrist plyrist_audio plyr-list-popup player bg-overlay b-t fixed-bottom" id="plyrist">
            <audio controls hidden></audio>
            <div class="plyr-list bg-dark-overlay" style="display:none"></div>
        </div>
    </footer>

    <script src="~/libs/jquery/dist/jquery.min.js"></script>
    <script src="~/libs/popper.js/dist/umd/popper.min.js"></script>
    <script src="~/libs/bootstrap/dist/js/bootstrap.min.js"></script>
    <script src="~/libs/pjax/pjax.min.js"></script>
    <script src="~/assets/js/ajax.js" asp-append-version="true"></script>
    <script src="~/assets/js/lazyload.config.js" asp-append-version="true"></script>
    <script src="~/assets/js/lazyload.js" asp-append-version="true"></script>
    <script src="~/assets/js/plugin.js" asp-append-version="true"></script>
    <script src="~/libs/scrollreveal/dist/scrollreveal.min.js"></script>
    <script src="~/libs/feather-icons/dist/feather.min.js"></script>
    <script src="~/assets/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/player.js" asp-append-version="true"></script>
    <script src="~/js/site-ui.js" asp-append-version="true"></script>
</body>
</html>
