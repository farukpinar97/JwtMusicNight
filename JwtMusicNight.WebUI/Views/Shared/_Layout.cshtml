@{
    var givenName = User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
    var fullName = $"{givenName} {User.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value}".Trim();
    var package = PackageHelper.UserPackage(User);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => controller == name ? "active" : "";
}
<!DOCTYPE html>
<html lang="tr" dir="ltr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] | Music Night</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/assets/css/bootstrap.css" />
    <link rel="stylesheet" href="~/assets/css/theme.css" />
    <link rel="stylesheet" href="~/assets/css/style.css" />
    <link rel="stylesheet" href="~/css/site-ui.css" asp-append-version="true" />
    <style>
        .btn-play.loading { opacity: .5; pointer-events: none; }
        #upgradeModal .modal-content, #errorModal .modal-content { background: #1b1b25; color: #fff; border: 1px solid rgba(255,255,255,.08); border-radius: 18px; }
    </style>
</head>
<body class="layout-column bg-dark mn-body">
    @* Oynatıcı ikonları (gömülü SVG sprite) *@
