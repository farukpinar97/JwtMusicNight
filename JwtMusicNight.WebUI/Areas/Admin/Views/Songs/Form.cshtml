@model AdminSongDto
@{
    var isEdit = Model.SongId > 0;
    ViewData["Title"] = isEdit ? "Şarkı Düzenle" : "Yeni Şarkı";
}

<div class="admin-page-header">
    <div class="flex">
        <a asp-action="Index" class="text-muted"><i data-feather="arrow-left"></i> Şarkılar</a>
        <h2>@(isEdit ? Model.SongName : "Yeni Şarkı")</h2>
    </div>
    @if (isEdit)
    {
        <a asp-area="" asp-controller="Music" asp-action="Detail" asp-route-id="@Model.SongId" target="_blank" class="btn-admin btn-admin-ghost">
            <i data-feather="external-link"></i> Sitede Gör
        </a>
    }
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="admin-card">
            <h6>Şarkı Bilgileri</h6>
            <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="admin-form">
                <div asp-validation-summary="ModelOnly" class="info-note"></div>
                <input type="hidden" asp-for="SongId" />

                <div class="form-row">
                    <div class="form-group col-md-8">
                        <label asp-for="SongName"></label>
                        <input asp-for="SongName" class="form-control" placeholder="Örn. Blinding Lights" />
                        <span asp-validation-for="SongName" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-4">
                        <label asp-for="RequiredPackage"></label>
                        <select asp-for="RequiredPackage" asp-items="ViewBag.Packages" class="form-control"></select>
                        <small class="text-muted">Bu paket ve üstündekiler dinleyebilir.</small>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="ArtistId"></label>
                        <select asp-for="ArtistId" asp-items="ViewBag.Artists" class="form-control">
                            <option value="0">Sanatçı seçin</option>
                        </select>
                        <span asp-validation-for="ArtistId" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-6">
                        <label asp-for="GenreId"></label>
                        <select asp-for="GenreId" asp-items="ViewBag.Genres" class="form-control">
                            <option value="0">Tür seçin</option>
                        </select>
                        <span asp-validation-for="GenreId" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label asp-for="DurationText"></label>
                        <div class="input-icon">
                            <i data-feather="clock"></i>
                            <input asp-for="DurationText" class="form-control" placeholder="3:25" />
                        </div>
                        <span asp-validation-for="DurationText" class="text-danger"></span>
                    </div>
                    <div class="form-group col-md-6">
                        <label asp-for="ReleaseDate"></label>
                        <input asp-for="ReleaseDate" type="date" class="form-control" />
                    </div>
                </div>

                <partial name="_ImagePicker" model='("CoverImageUrl", Model.CoverImageUrl, "Kapak görseli")' />

                <div class="form-group">
                    <label asp-for="Lyrics"></label>
                    <textarea asp-for="Lyrics" rows="5" class="form-control" placeholder="İsteğe bağlı"></textarea>
                </div>

                <div class="d-flex" style="gap:10px">
                    <button type="submit" class="btn-admin btn-admin-primary" data-loading-text="Kaydediliyor…"><i data-feather="save"></i> @(isEdit ? "Değişiklikleri Kaydet" : "Şarkıyı Oluştur")</button>
                    <a asp-action="Index" class="btn-admin btn-admin-ghost">Vazgeç</a>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="admin-card">
            <h6>MP3 Dosyası</h6>
            @if (!isEdit)
            {
                <div class="info-note mb-0">
                    <i data-feather="info"></i>
                    <div>Şarkıyı oluşturduktan sonra MP3 dosyasını buradan yükleyebilirsiniz.</div>
                </div>
            }
            else
            {
                if (Model.HasAudioFile)
                {
                    <div class="file-status ok"><i data-feather="check-circle"></i><div>Yüklü: <code>@Model.AudioUrl</code></div></div>
                }
                else
                {
                    <div class="file-status missing"><i data-feather="alert-triangle"></i><div>MP3 yüklenmemiş. Kullanıcılar "dosya bulunamadı" uyarısı alır.</div></div>
                }

                <form asp-action="UploadAudio" asp-route-id="@Model.SongId" method="post" enctype="multipart/form-data">
                    <label class="dropzone-box">
                        <input type="file" name="file" accept=".mp3,audio/mpeg" required />
                        <i data-feather="upload-cloud"></i>
                        <div class="dz-title">@(Model.HasAudioFile ? "Yeni MP3 seç" : "MP3 dosyası seç")</div>
                        <div class="dz-sub">Tıklayın veya sürükleyip bırakın · en fazla 50 MB</div>
                        <div class="dz-file"></div>
                    </label>
                    <button type="submit" class="btn-admin btn-admin-success w-100" data-loading-text="Yükleniyor… büyük dosyalarda biraz sürebilir"><i data-feather="upload"></i> Yükle</button>
                </form>
            }
        </div>

        @if (isEdit)
        {
            <div class="admin-card">
                <h6>Özet</h6>
                <div class="d-flex justify-content-between mb-3"><span class="text-muted">Şarkı Id</span><b>@Model.SongId</b></div>
                <div class="d-flex justify-content-between mb-3"><span class="text-muted">Dinlenme</span><b>@Model.ListenCount</b></div>
                <div class="d-flex justify-content-between align-items-center"><span class="text-muted">Paket</span><partial name="_PackagePill" model="Model.RequiredPackage" /></div>
            </div>
        }
    </div>
</div>

@section Scripts { <partial name="_FormScripts" /> }
